{
  "name": "scholarmind",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp": "node mcp/server.mjs",
    "test:watch": "vitest",
    "dev:local": "DATABASE_URL=postgres://scholarmind:scholarmind@127.0.0.1:5432/scholarmind vite",
    "docker:build": "docker build -t scholarmind .",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:reset": "tsx server/db/migrate.ts --reset",
    "spike:postgres": "node scripts/spike-postgres.mjs",
    "worker": "tsx server/worker.ts",
    "dev:worker": "DATABASE_URL=postgres://scholarmind:scholarmind@127.0.0.1:5432/scholarmind tsx server/worker.ts",
    "spike:models": "node scripts/spike-models.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.21.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/pg": "^8.23.1",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.0.2",
    "hono": "^4.13.7",
    "katex": "^0.18.7",
    "lucide-react": "^0.563.0",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
