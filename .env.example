# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; .env.example is not.
# ---------------------------------------------------------------------------

# REQUIRED. Google AI Studio key: https://aistudio.google.com/apikey
# Read server-side only and never bundled into the browser.
# The Developer API (not Vertex) is used in every environment, because
# File Search is unavailable on Vertex.
GEMINI_API_KEY=AIzaSy...

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# Postgres. `docker compose up -d db` starts one matching this URL; in GCP this
# points at Cloud SQL. Same engine and extensions in both, so one schema.
DATABASE_URL=postgres://scholarmind:scholarmind@127.0.0.1:5432/scholarmind

# Connections per instance. Cloud Run runs many instances against one Cloud SQL
# connection ceiling, so keep this small and scale it deliberately.
# PGPOOL_MAX=5

# Access control. Off locally by design; the predicate collapses but the query
# shape is identical, so setting this to true exercises the production path
# without any other change.
# ACL_ENABLED=false

# The embedding dimension of gemini-embedding-2, needed by 0004_embeddings.sql.
# It is not guessable — measure it with `GEMINI_API_KEY=... npm run spike:postgres`
# and read check G2. Until this is set, search is keyword-only.
# EMBEDDING_DIM=

# Your real project ID when using Cloud Storage for blobs.
GOOGLE_CLOUD_PROJECT=scholarmind-local

# Prefix for File Search store names, so local stores are easy to spot and clean
# up. There is no File Search emulator: retrieval always hits the real API.
FILE_SEARCH_STORE_PREFIX=dev-

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Open-access PDF lookup via Unpaywall. Their terms require a contact address;
# the step is skipped entirely when this is unset.
# UNPAYWALL_EMAIL=you@example.com

# Where blobs go. Unset uses ./.data/blobs locally; set GCS_BUCKET to use
# Cloud Storage instead (this is what Cloud Run sets).
# GCS_BUCKET=my-project-scholarmind
# LOCAL_BLOB_DIR=./.data/blobs

# ---------------------------------------------------------------------------
# Production only (set by Cloud Run / cloudbuild.yaml, not needed locally)
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=8080
# IAP audience: /projects/<PROJECT_NUMBER>/global/backendServices/<SERVICE_ID>
# Without it the server refuses IAP assertions rather than trusting them.
# IAP_AUDIENCE=

# Programmatic access (the MCP server, scripts). Optional.
# When set, a request presenting a WRONG key is refused in every environment;
# a request with no key at all is still the local browser.
SCHOLARMIND_API_KEY=

# ^ Deployment-wide bootstrap key, superseded by per-user keys.
#
# It maps to ONE configured identity (API_USER_ID), so under multi-tenancy every
# caller presenting it is the same person. Handing it to two people gives them
# the same libraries. Leave it unset and let each person mint their own from
# POST /api/keys instead — those act as their owner and inherit their sharing.
# Kept only so existing MCP clients and scripts keep working.

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------

# Replaces IAP. Create an OAuth 2.0 Client ID (type: Web application) in the
# Google Cloud console, and register the callback below as an authorised
# redirect URI — it must match exactly, including scheme and port.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where the app is reached from. The OAuth callback is built from this, so it
# must be the origin the browser actually uses, not the container's own address.
PUBLIC_ORIGIN=http://localhost:3000

# Domains permitted to sign in, comma-separated. Checked against the ID token's
# verified `hd` claim for Workspace accounts, falling back to the address.
#
# UNSET MEANS ANY GOOGLE ACCOUNT MAY SIGN IN. That is fine for a dev project and
# wrong for anything holding real libraries: profiles default to org-visible, so
# a stranger who signs into the same org can read them.
# AUTH_ALLOWED_DOMAINS=example.com,example.org

# How long a session lasts.
# SESSION_DAYS=30

# ---------------------------------------------------------------------------
# Queue worker (npm run worker)
# ---------------------------------------------------------------------------

# Papers processed in parallel by one worker. Two matches the API rate limits
# the in-process pool was tuned for.
# WORKER_CONCURRENCY=2

# How long a job may go without a heartbeat before it is treated as abandoned
# and requeued. Must exceed the longest single pipeline step.
# WORKER_STALE_SECONDS=120

# How often the scheduler looks for crawlers whose interval has elapsed.
# CRAWLER_TICK_SECONDS=60
